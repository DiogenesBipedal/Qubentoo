# Qubentoo dom0 kernel config — Apple MacBook Air 2013 supplement
# Apply AFTER qubentoo-dom0.config:
#   scripts/kconfig/merge_config.sh .config \
#       qubentoo-dom0.config qubentoo-apple-mba2013.config
#
# Hardware: MacBook Air Mid-2013, 11" (A1465) or 13" (A1466)
# CPU:   Intel Haswell i5-4250U / i7-4650U (VT-x + VT-d present)
# GPU:   Intel HD Graphics 5000 (GT3)
# SSD:   Apple proprietary PCIe (AHCI over PCIe) → appears as /dev/sda
# WiFi:  Broadcom BCM4360 — see docs/hardware/macbook-air-2013.md
# Track: Apple Multi-Touch BCM5974 (USB bus emulation)
# Audio: Intel HDA + Cirrus Logic CS4208 codec
# TB:    Intel DSL5320 Thunderbolt 2
# Boot:  Apple EFI — requires --removable grub-install or direct xen.efi

# -------------------------------------------------------------------
# DISPLAY — Intel HD Graphics 5000 (Haswell GT3, i915)
# -------------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_I915=m
# EFI framebuffer for early console before i915 loads
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# -------------------------------------------------------------------
# INPUT — Apple keyboard, BCM5974 Multi-Touch trackpad, HID quirks
# -------------------------------------------------------------------
CONFIG_HID_APPLE=y
# BCM5974: Apple Multi-Touch trackpad and Magic Mouse
CONFIG_MOUSE_BCM5974=m
CONFIG_INPUT_EVDEV=m
CONFIG_INPUT_MOUSEDEV=m
# USB HID (internal keyboard and trackpad both appear on USB in 2013)
CONFIG_USB_HID=y
CONFIG_USB=y

# -------------------------------------------------------------------
# STORAGE — Apple PCIe SSD (AHCI over PCIe) → /dev/sda
# 2013 MBA uses AHCI, NOT NVMe. Kernel must have SATA_AHCI built-in.
# -------------------------------------------------------------------
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_MOD=y

# -------------------------------------------------------------------
# APPLE SMC — fan speed, battery, temperature, keyboard backlight
# Without this, the fan runs at max speed and backlight is uncontrolled
# -------------------------------------------------------------------
CONFIG_SENSORS_APPLESMC=m
CONFIG_SERIO=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_APPLE=m
CONFIG_BACKLIGHT_LCD_SUPPORT=y

# -------------------------------------------------------------------
# WIFI — Broadcom BCM4360
#
# Two options (mutually exclusive at runtime):
#   A) brcmfmac + linux-firmware (open, kernel-native, partial support)
#   B) net-wireless/broadcom-sta (proprietary wl driver, full support)
#
# For Qubes production use: WiFi will be PCI-passthrough'd to a NetVM.
# For initial bootstrap (before NetVM is set up): use option B.
#
# brcmfmac is compiled in here. To use broadcom-sta instead:
#   emerge net-wireless/broadcom-sta
#   echo "blacklist brcmfmac" >> /etc/modprobe.d/broadcom.conf
#   echo "blacklist brcmutil" >> /etc/modprobe.d/broadcom.conf
# -------------------------------------------------------------------
CONFIG_BRCMFMAC=m
CONFIG_BRCM80211=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# -------------------------------------------------------------------
# BLUETOOTH — Broadcom BCM20702A0 (USB)
# -------------------------------------------------------------------
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m

# -------------------------------------------------------------------
# THUNDERBOLT — Intel DSL5320 (Thunderbolt 2)
# -------------------------------------------------------------------
CONFIG_THUNDERBOLT=m
CONFIG_THUNDERBOLT_NET=m

# -------------------------------------------------------------------
# AUDIO — Intel HDA with Cirrus Logic CS4208 codec
# -------------------------------------------------------------------
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_CIRRUS=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_INPUT_BEEP=y

# -------------------------------------------------------------------
# POWER MANAGEMENT / ACPI / BATTERY
# Critical for battery life and thermal management on laptop
# -------------------------------------------------------------------
CONFIG_ACPI=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_VIDEO=m
CONFIG_THERMAL=y
CONFIG_THERMAL_NETLINK=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE=y
CONFIG_INTEL_IDLE=y
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_PM_DEBUG=n

# -------------------------------------------------------------------
# EFI — Apple firmware requires these for correct boot
# -------------------------------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_VARS=y
CONFIG_APPLE_PROPERTIES=y
CONFIG_EFIVAR_FS=y

# -------------------------------------------------------------------
# USB 3.0 — Intel xHCI (Haswell)
# -------------------------------------------------------------------
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y

# -------------------------------------------------------------------
# NETWORK (wired via Thunderbolt adapter or USB-Ethernet)
# -------------------------------------------------------------------
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_USB_NET_ASIX=m

# -------------------------------------------------------------------
# SD CARD (built-in reader, right side of MBA)
# -------------------------------------------------------------------
CONFIG_MMC=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m

# -------------------------------------------------------------------
# WEBCAM — Apple FaceTime HD camera (USB)
# -------------------------------------------------------------------
CONFIG_VIDEO_DEV=m
CONFIG_VIDEO_V4L2=m
CONFIG_USB_VIDEO_CLASS=m

# -------------------------------------------------------------------
# WATCHDOG (used by Xen tools)
# -------------------------------------------------------------------
CONFIG_WATCHDOG=y
CONFIG_ITCO_WDT=m
