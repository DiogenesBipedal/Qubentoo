# Qubentoo dom0 kernel config fragment
# Apply on top of a gentoo-sources hardened config:
#   scripts/kconfig/merge_config.sh .config qubentoo-dom0.config
#
# Requires: gentoo-sources >= 6.1 or vanilla >= 6.1 with Xen patches

# -------------------------------------------------------------------
# XEN DOM0 SUPPORT
# -------------------------------------------------------------------
CONFIG_XEN=y
CONFIG_XEN_DOM0=y
CONFIG_XEN_PRIVILEGED_GUEST=y

# PV, HVM, and PVH guest types
CONFIG_XEN_PVCALLS_BACKEND=y
CONFIG_XEN_BACKEND=y
CONFIG_XEN_NETDEV_BACKEND=m
CONFIG_XEN_BLKDEV_BACKEND=m
CONFIG_XEN_SCSI_BACKEND=m
CONFIG_XEN_USB_BACKEND=m
CONFIG_XEN_PCIDEV_BACKEND=m
CONFIG_XEN_FBDEV_FRONTEND=m

# Xen balloon memory
CONFIG_XEN_BALLOON=y
CONFIG_XEN_SELFBALLOONING=y
CONFIG_XEN_BALLOON_MEMORY_HOTPLUG=y

# Xen platform bus (required for PV tools in HVM guests)
CONFIG_XEN_PLATFORM_PCI=y

# Xen grant table and event channel devices
CONFIG_XEN_DEV_EVTCHN=y
CONFIG_XEN_GNTDEV=y
CONFIG_XEN_GRANT_DEV_ALLOC=y

# Xen ACPI processor
CONFIG_XEN_ACPI_PROCESSOR=m

# Xen privcmd
CONFIG_XEN_PRIVCMD=y

# Xenbus (required for all Xen drivers)
CONFIG_XENFS=y
CONFIG_XEN_COMPAT_XENFS=y

# Xen PCI passthrough / IOMMU
CONFIG_XEN_PCIDEV_FRONTEND=y
CONFIG_PCI_XEN=y
CONFIG_SWIOTLB_XEN=y

# IOMMU — needed for secure PCI passthrough
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y
CONFIG_AMD_IOMMU_V2=y
CONFIG_IRQ_REMAP=y

# -------------------------------------------------------------------
# HARDENED GENTOO / SECURITY OPTIONS
# -------------------------------------------------------------------

# Stack protection
CONFIG_CC_STACKPROTECTOR_STRONG=y
# (legacy alias; keep for older configs)
CONFIG_STACKPROTECTOR_STRONG=y

# _FORTIFY_SOURCE equivalent in-kernel
CONFIG_FORTIFY_SOURCE=y

# Safe memory copies — prevents kernel from copying uninitialised slab
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_FALLBACK=n

# Restrict /dev/mem and /dev/kmem
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y

# Prevent /proc/kcore, /proc/kallsyms leaks
CONFIG_SECURITY_DMESG_RESTRICT=y

# Randomise kernel address layout
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y

# Restrict kernel pointer exposure
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y

# Page table isolation (Meltdown mitigation)
CONFIG_PAGE_TABLE_ISOLATION=y

# Retpoline (Spectre v2)
CONFIG_RETPOLINE=y

# Speculative Store Bypass (SSB) mitigation
CONFIG_SPECULATION_MITIGATIONS=y

# Protect against ROP via shadow call stack (ARM64 only, no-op on x86)
# CONFIG_SHADOW_CALL_STACK is not set

# Kernel integrity checking
CONFIG_INTEGRITY=y
CONFIG_IMA=y
CONFIG_IMA_DEFAULT_HASH="sha256"
CONFIG_EVM=y

# Prevent loading unsigned / non-Kconfig modules
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA256=y

# CRITICAL: No forced module unload — avoids race conditions in passthrough
# CONFIG_MODULE_FORCE_UNLOAD is not set

# Lock down kernel (integrity mode at minimum)
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y

# -------------------------------------------------------------------
# GRSECURITY-COMPATIBLE OPTIONS (no patch required)
# -------------------------------------------------------------------
# These upstream equivalents approximate grsec protections

# Restrict /proc/$pid to owner (equivalent to GRKERNSEC_PROC_USER)
CONFIG_PROC_MEM_ALWAYS_OPEN=n
# CONFIG_CHECKPOINT_RESTORE is not set

# Restrict ptrace (equivalent to GRKERNSEC_PTRACE)
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
# Set Yama ptrace scope to 1+ via sysctl: kernel.yama.ptrace_scope=2

# Slab freelist randomisation (equivalent to PAX_MEMORY_SANITIZE in part)
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y

# Kernel heap canaries
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y

# Restrict kexec (equivalent to GRKERNSEC_KEXEC)
CONFIG_KEXEC=y
CONFIG_KEXEC_SIG=y
# CONFIG_KEXEC_FILE is not set

# Kernel address exposure via /proc
# CONFIG_KALLSYMS is not set

# -------------------------------------------------------------------
# QUBES DOM0 SPECIFIC NETWORKING
# -------------------------------------------------------------------
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NF_CONNTRACK=y
CONFIG_BRIDGE=m
CONFIG_TUN=m
CONFIG_VETH=m

# Firewall for qubes networking VMs
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y

# -------------------------------------------------------------------
# MISCELLANEOUS DOM0 REQUIREMENTS
# -------------------------------------------------------------------

# USB passthrough to qubes
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y

# Audio passthrough (PCI pass-through to audio qube)
CONFIG_SND=m
CONFIG_SND_PCI=y

# VirtIO (for non-Xen template VMs if needed)
CONFIG_VIRTIO=m
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_BLK=m

# EFI support (modern UEFI system)
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# GRUB multiboot2 (required for Xen bootloader)
CONFIG_RELOCATABLE=y
CONFIG_X86_NEED_RELOCS=y
