#!/sbin/openrc-run
# qubesdb — QubesDB key-value store daemon (dom0 and domU)

description="QubesDB key-value store daemon"
pidfile="/run/qubes/qubesdb.pid"
command="/usr/sbin/qubesdb-daemon"
command_args="${QUBESDB_EXTRA_ARGS}"
command_background="yes"
start_stop_daemon_args="--background --make-pidfile --pidfile ${pidfile}"

: ${QUBESDB_SOCKET:=/run/qubes/qubesdb.sock}

depend() {
	need xenstored
	before qubesd qubes-core qubes-agent qubes-gui-daemon
	keyword -lxc -openvz -prefix
}

start_pre() {
	checkpath -d -m 0755 -o root:qubes /run/qubes
	checkpath -d -m 0755 /var/run/qubes
}
